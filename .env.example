# =========================================================
# Modelo de variaveis de ambiente.
# Copie este arquivo para .env antes de subir o projeto:
#   Windows : Copy-Item .env.example .env
#   Linux   : cp .env.example .env
#
# O .env NAO deve ser versionado (ja esta no .gitignore).
# =========================================================

# ---- Banco de dados ----
DB_NAME=cidades_esg
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# O banco e acessivel somente pela rede interna do Compose.

# ---- API ----
# Porta em que a API fica acessivel no host: http://localhost:8080
API_PORT=8080

# Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Production
APP_VERSION=local
API_IMAGE=cidades-esg-api:local

# =========================================================
# Somente para deploy em provedor gerenciado (Render/Neon).
# Quando DATABASE_URL esta definida, ela tem prioridade sobre as
# variaveis DB_* acima. Nao use no docker-compose local.
#
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# =========================================================
